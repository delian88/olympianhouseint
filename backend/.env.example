# =============================================================================
# OHI Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# ─── MySQL Database (Namecheap) ───────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DBNAME
# On Namecheap shared hosting, HOST is usually "localhost"
DATABASE_URL="mysql://db_user:db_password@localhost:3306/db_name"

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Token expiry in seconds (default: 86400 = 24 hours)
JWT_EXPIRY=86400

# ─── Application ─────────────────────────────────────────────────────────────
# Full URL where the API will be hosted (no trailing slash)
APP_URL="https://yourdomain.com/api"

# Allowed frontend origin for CORS (your Namecheap domain or Vercel URL)
CORS_ORIGIN="https://yourdomain.com"

# Environment: "development" or "production"
APP_ENV="production"
